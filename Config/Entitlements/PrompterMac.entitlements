<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Prompter for Mac, store flavor only (Store Debug and Store Release; PROMPTER_MAC_ENTITLEMENTS_store in
  Config/Signing.xcconfig). The selfbuild and qa flavors carry none of these. The App Sandbox itself comes from the
  ENABLE_APP_SANDBOX build setting; the sandbox's network and file keys are not added yet. The container and the
  key-value store are the same as the iPhone app's (the store flavor shares its bundle ID).
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(PROMPTER_CLOUD_CONTAINER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(PROMPTER_APP_ID)</string>
</dict>
</plist>
